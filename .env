# Primary exchange credentials (Bitget)
EXCHANGE_API_KEY=your_bitget_api_key
EXCHANGE_API_SECRET=your_bitget_api_secret
EXCHANGE_PASSPHRASE=the_bitget_passphrase_you_made_at_api_creation

# Optional XT.com fallback credentials.
# XT.com is used as a market-data fallback only when Bitget fails.
# Leave these unset if XT public market-data access is sufficient.
XT_API_KEY=
XT_API_SECRET=
XT_PASSPHRASE=

# Discord Configuration
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_id/your_token

# Environment
ENV=prod
